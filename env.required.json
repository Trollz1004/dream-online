{
  "service": "dream-engine",
  "node": "alienware",
  "envFile": ".env",
  "required": [
    "DREAM_ENGINE_TOKEN",
    "GEMINI_API_KEY"
  ],
  "alternatives": {
    "DREAM_ENGINE_TOKEN": [
      "FLEET_SHARED_TOKEN"
    ]
  },
  "optional": [
    "DREAM_ENGINE_BIND",
    "PORT",
    "NODE_ENV",
    "ROUTER_CONSOLE_ENABLED",
    "ROUTER_CONSOLE_DAILY_CAP",
    "ROUTER_CONSOLE_TOKEN_BUDGET",
    "ROUTER_CONSOLE_MODEL"
  ]
}
