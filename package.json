{
  "name": "dream-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts ops/router/*.test.ts ops/judge-memory/*.test.ts ops/hooks/*.test.mjs",
    "test:hooks": "node --test ops/hooks/*.test.mjs",
    "hooks:install": "git config core.hooksPath ops/hooks",
    "prepare": "git config core.hooksPath ops/hooks || exit 0",
    "eyes": "tsx ops/eyes/eyes.ts",
    "test:eyes": "node --import tsx --test --test-concurrency=1 ops/eyes/test/*.test.ts"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
