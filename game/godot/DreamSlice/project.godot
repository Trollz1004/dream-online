; DREAM ONLINE combat slice.
; Godot 4 project file. Engine: Godot 4.7.2 stable.

config_version=5

[application]

config/name="DREAM ONLINE - Combat Slice"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

; 1920x1080: Godot's own Movie Maker mode (--write-movie) always renders at
; the project's configured viewport size and ignores a --resolution flag on
; the command line (documented behaviour, confirmed 2026-09-23 rendering
; 1280x720 despite --resolution 1920x1080 for the crowdfunding demo's
; recording); any launcher that wants a smaller interactive window already
; passes its own --resolution (Open-DreamSlice.cmd: 1600x900).
window/size/viewport_width=1920
window/size/viewport_height=1080
; Windowed, never fullscreen (Joshua, 2026-09-24: "keep window mode for game
; be best"; he splits his desk between a TV and a monitor). canvas_items
; stretch scales the HUD with the window, so a 1280x720 window on the TV
; shows the whole readout instead of cropping it.
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=24.0

[rendering]

; 2x MSAA as the interactive baseline (both --demo and hand-play): a light,
; always-safe edge-quality bump on the RX 6800 at 1080p, cheap enough to stay
; on for the playable slice. The genuinely expensive anti-aliasing tier (4x
; MSAA plus TAA) is reserved for the --demo recording path (spec 003 lever 3)
; and is set at runtime in scripts/demo_director.gd's own _apply_demo_quality,
; never here, so it never taxes the interactive frame budget.
anti_aliasing/quality/msaa_3d=1
