DerivedDataCache/
Intermediate/
Saved/
*.sln
*.opensdf
*.sdf
*.suo
*.xcodeproj/

# Legacy local stubs not reviewed for clean public/private repo
ops/legacy/

# Non-Dream support material stays out of this repo
support/anythingllm/

# Keep Dream repo independent from local Paperclip and ANTIGRAVITY sync state
paperclip-tro/
adapters/sync-from-antigravity.ps1
