game/server/world_state.json

# Unreal test zone: rebuilt locally by game/unreal/New-DreamTestZone.ps1 from the installed engine template; Epic's licence forbids committing this content
game/unreal/DreamOnline/Content/
game/unreal/DreamOnline/Binaries/
game/unreal/DreamOnline/Intermediate/
game/unreal/DreamOnline/Saved/
game/unreal/DreamOnline/DerivedDataCache/
game/unreal/DreamOnline.backup-*/

# Python bytecode written when Unreal runs the map scripts
__pycache__/

# Godot editor cache and exports
game/godot/*/.godot/
game/godot/*/export/

# Exported builds (web and desktop) - never committed
/build/
