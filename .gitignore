**/outputs/

# Dependency and build output
node_modules/
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/

# Logs and runtime state
*.log
logs/
*.jsonl
game/server/live-npc-lab/data/*.jsonl

# Story/twist spoiler content — OneDrive only, never repo, even private
game/server/live-npc-lab/data/lore-snippets.json

# npc-profiles.json is NOT ignored, deliberately. It is a test input:
# test/npc-profiles.mjs reads data/npc-profiles.json directly and CI fails with
# ENOENT without it. It also holds no spoiler material — the file self-declares
# noClassifiedPlotMaterial, and every id in it (sup-guide, camp-guard,
# c0d3x-rider, ...) is already committed inside test/npc-profiles.mjs, which
# hard-asserts them. Ignoring it protected nothing and broke the build.
# lore-snippets.json stays ignored: test/lore-retrieval.mjs writes its own
# temp fixture and never reads the real file.

# Backups, exports, and cold copies
ops/backups/
**/backups/
**/*coldcopy*/
**/*export*/

# OS/editor noise
Thumbs.db
desktop.ini
.DS_Store

# Unreal future outputs
Binaries/
DerivedDataCache/
Intermediate/
Saved/
*.sln
*.opensdf
*.sdf
*.suo
*.xcodeproj/

# Legacy local stubs not reviewed for clean public/private repo
ops/legacy/

# Non-Dream support material stays out of this repo
support/anythingllm/

# Keep Dream repo independent from local Paperclip and ANTIGRAVITY sync state
paperclip-tro/
adapters/sync-from-antigravity.ps1

# Obsidian vault lives here on the Alienware clone; never tracked
DREAM-ONLINE/

# Reference material folded in from old copies on 2026-09-19, not yet checked as public-safe
/references/_unreviewed/

# Alienware node: health probe output is runtime state
ops/node/heartbeat/

