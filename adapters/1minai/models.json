  "request_format": {
    "chat": {
      "method": "POST",
      "path": "/api/v1/oneai/chat",
      "body": {
        "type": "chat",
        "model": "{model_id}",
        "promptObject": {
          "prompt": "{user_message}",
          "conversationId": "{optional}",
          "settings": {},
          "attachments": {}
        }
      }
    },
    "feature": {
      "method": "POST",
      "path": "/api/v1/oneai/features",
      "body": {
        "type": "{feature_type}",
        "model": "{model_id}",
        "promptObject": {}
      }
    }
  }
