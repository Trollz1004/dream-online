# Dream Online + DREAM Engine & DREAM Maker Studio local configuration.
# Copy to `.env` only for local use. Never commit real values.

# --- Monorepo & Live Game Services ---
DREAM_ROOT=C:\DREAM\dream-online
DREAM_LIVE_NPC_HOST=127.0.0.1
DREAM_LIVE_NPC_PORT=9127
DREAM_ENABLE_CLOUD_AI=0
DREAM_AI_PROVIDER=mock

# --- 1min.AI Lifetime Subscription Cloud NPC Provider (Zero Per-Token Surprise Cost) ---
# Set DREAM_ENABLE_CLOUD_AI=1 and DREAM_AI_PROVIDER=1min-ai to route in-game NPCs
# through your paid lifetime 1min.AI cloud subscription (https://api.1min.ai/api/v1/oneai/chat).
ONEMINAI_API_KEY="MY_ONEMINAI_API_KEY"
NPC_1MINAI_MODEL="gemini-2.5-flash"

# --- Google AI Ultra / Gemini Spark / AI Studio (DREAM Engine & Maker Studio) ---
# GEMINI_API_KEY: Required for Gemini AI API calls and Ultra Agent SDK (/api/agent/ultra-assist).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where the DREAM Engine & Studio applet is hosted.
APP_URL="http://localhost:3000"

# --- OpenDesign SDK / MCP ---
# OPENDESIGN_API_KEY: OpenDesign SDK / MCP key for in-engine UI/HUD prototyping (.40)
# and T5500 (.15 OPSis) crowdfunding & #UntilNoKidInNeed marketing asset generation.
OPENDESIGN_API_KEY="MY_OPENDESIGN_API_KEY"
